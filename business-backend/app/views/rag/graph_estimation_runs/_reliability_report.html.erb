<%# Reliability report (analysis_agent · El Oráculo). Shared by gate 2 and the
    completed screen. Local: `report` (the run.analysis_report hash). %>
<div class="rounded-md border border-white/10 bg-ink/30 p-4">
  <div class="flex items-center gap-3 mb-2 flex-wrap">
    <span class="text-xs uppercase tracking-tight font-bold text-white/50">Informe de fiabilidad · El Oráculo</span>
    <% conf = report["overall_confidence"] %>
    <span class="px-2.5 py-0.5 rounded-md text-xs font-bold <%= conf == "high" ? "bg-success/15 border border-success/40 text-success-light" : conf == "low" ? "bg-brand/15 border border-brand text-brand-soft" : "bg-ink/40 border border-white/10 text-white/70" %>">
      confianza: <%= conf || "—" %>
    </span>
    <span class="text-xs text-white/50">tareas ancladas: <%= (report["grounded_task_ratio"].to_f * 100).round %>%</span>
  </div>
  <p class="text-sm text-white/70"><%= report["summary"] %></p>
  <% if Array(report["weak_points"]).any? %>
    <ul class="mt-3 space-y-1">
      <% Array(report["weak_points"]).each do |wp| %>
        <li class="text-xs text-white/60">
          <span class="font-bold text-brand-soft">[<%= wp["severity"] %>]</span>
          <span class="text-white/80"><%= wp["area"] %>:</span> <%= wp["issue"] %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
