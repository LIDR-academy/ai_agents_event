<% modules = run.adjusted_modules %>

<h2 class="text-lg font-bold tracking-tight text-white mb-1">5 · Validación de horas y tarifas</h2>
<p class="text-white/50 text-sm mb-5">
  Las horas vienen del corpus histórico; aquí tienes la última palabra. Ajusta horas y
  <span class="text-white/80">tarifa €/h</span> por tarea (completa las marcadas en rojo), añade o
  elimina filas; el coste por módulo y el total se recalculan al vuelo. Al confirmar, la estimación
  queda almacenada.
</p>

<%= render "step_agent", keys: [ "gate_analysis" ], note: "validación humana" %>

<% if !run.step_complete?("hours") %>
  <div class="p-4 rounded-md bg-brand/15 border border-brand text-brand-soft">
    Aún no hay horas estimadas. Vuelve a
    <%= link_to "Horas por tarea", rag_estimation_run_path(run, step: "hours"), class: "underline font-bold" %>.
  </div>
<% else %>
  <% if run.confirmed? %>
    <div class="p-3 rounded-md bg-success/15 border border-success/40 text-success-light text-sm mb-5">
      ✓ Confirmada el <%= run.adjusted_breakdown["confirmed_at"] %> ·
      <span class="font-bold"><%= run.adjusted_total_hours %></span> h ·
      <span class="font-bold"><%= format_eur(run.adjusted_total_cost) %></span>
    </div>
  <% end %>

  <div data-controller="estimate-modules-editor">
    <%= form_with url: verify_rag_estimation_run_path(run), method: :patch, local: true do %>
      <div data-estimate-modules-editor-target="modulesContainer">
        <% modules.each_with_index do |mod, m| %>
          <%= render "editable_module", m: m, mod: mod, mode: :cost,
                tasks: mod.tasks.each_with_index.map { |task, t| [ t, task ] } %>
        <% end %>
      </div>

      <p data-estimate-modules-editor-target="empty" class="<%= "hidden" if modules.any? %> p-4 text-white/40 text-sm">
        Sin módulos.
      </p>

      <div class="flex items-center justify-between mt-2 mb-4">
        <button type="button" data-action="estimate-modules-editor#addModule"
                class="text-brand font-bold hover:text-brand-soft tracking-tight text-sm cursor-pointer">
          + Añadir módulo
        </button>
        <div class="text-sm text-white/70">
          Total: <span class="text-white font-bold tabular-nums text-lg" data-estimate-modules-editor-target="total">0</span>
          <span class="text-white/50">€</span>
        </div>
      </div>

      <input type="hidden" name="total_cost_eur" data-estimate-modules-editor-target="totalField">

      <button type="submit"
              class="inline-flex items-center px-5 py-2.5 bg-brand text-ink-dark font-bold tracking-tight rounded-md hover:bg-brand-strong cursor-pointer transition-colors text-sm">
        Confirmar y almacenar estimación
      </button>

      <%# Templates cloned by the Stimulus editor (cost mode: hours + rate). %>
      <template data-estimate-modules-editor-target="moduleTemplate">
        <%= render "editable_module", m: "__MIDX__", mod: nil, tasks: [], mode: :cost %>
      </template>
      <template data-estimate-modules-editor-target="taskTemplate">
        <%= render "editable_task", m: "__MIDX__", t: "__TIDX__", task: nil, mode: :cost %>
      </template>
    <% end %>
  </div>
<% end %>
