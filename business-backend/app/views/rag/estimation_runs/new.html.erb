<% content_for :title, "RAG Wizard · nueva ejecución" %>

<div class="max-w-3xl mx-auto px-4 py-10">
  <div class="mb-6">
    <h1 class="text-3xl font-bold tracking-tighter text-white mt-1">Estimación guiada (RAG)</h1>
    <p class="text-white/60 mt-2">
      Pega una transcripción de reunión y recorre el pipeline RAG paso a paso: el servicio IA la
      convierte en un brief, recupera presupuestos históricos, ensambla el contexto y genera una
      estimación fundamentada que podrás verificar a mano.
    </p>
  </div>

  <%= form_with url: rag_estimation_runs_path, scope: :estimation_run, local: true,
        class: "space-y-5",
        data: { controller: "transcription-upload form-loading", action: "submit->form-loading#start" } do |f| %>

    <% if flash.now[:alert] %>
      <div class="p-4 rounded-md bg-brand/15 border border-brand text-brand-soft">
        <%= flash.now[:alert] %>
      </div>
    <% end %>

    <div>
      <div class="flex items-center justify-between mb-1">
        <%= f.label :transcript, "Transcripción", class: "block text-sm font-bold text-white/90" %>
        <label class="text-xs font-bold tracking-tight text-brand hover:text-brand-soft cursor-pointer">
          Subir .txt
          <input type="file" accept=".txt,text/plain" class="hidden"
                 data-action="change->transcription-upload#load"
                 data-transcription-upload-target="fileInput">
        </label>
      </div>
      <%= f.text_area :transcript, rows: 14,
            class: "w-full border border-white/20 rounded-md p-3 text-white bg-ink/40 placeholder:text-white/40 focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand",
            placeholder: "Pega aquí la transcripción de la discovery call (mín. ~100 caracteres).",
            data: { transcription_upload_target: "textarea" } %>
      <div class="flex items-center justify-between mt-1">
        <p class="text-xs text-white/50">
          Ejemplos en el repo: <code class="text-white/70">examples/transcripts/01_clear.txt</code>,
          <code class="text-white/70">02_ambiguous.txt</code>, <code class="text-white/70">03_hard.txt</code>.
        </p>
        <span class="text-xs text-white/70" data-transcription-upload-target="status"></span>
      </div>
    </div>

    <div class="pt-2">
      <button type="submit" data-form-loading-target="submit" data-disable-with="false"
              class="inline-flex items-center px-6 py-3 bg-brand text-ink-dark font-bold tracking-tight rounded-md hover:bg-brand-strong cursor-pointer transition-colors disabled:cursor-not-allowed">
        <span data-form-loading-target="label">Empezar el pipeline →</span>
        <svg data-form-loading-target="spinner" class="hidden ml-2 h-5 w-5 animate-spin"
             xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
      </button>

      <div data-form-loading-target="statusPanel"
           class="hidden mt-4 p-4 rounded-md bg-ink/30 border border-white/10 flex items-center gap-3"
           role="status" aria-live="polite">
        <svg class="h-5 w-5 animate-spin text-brand shrink-0" xmlns="http://www.w3.org/2000/svg"
             fill="none" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
        <div class="flex-1 text-sm">
          <span class="text-white/90" data-form-loading-target="phaseText">Reformulando la transcripción…</span>
          <span class="ml-2 font-mono text-xs text-white/50" data-form-loading-target="timer">00:00</span>
        </div>
      </div>
    </div>
  <% end %>
</div>
