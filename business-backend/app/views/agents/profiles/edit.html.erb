<% content_for :title, "Editar perfil de agente · Estimator" %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tighter text-white">Editar perfil «<%= @profile.name %>»</h1>
      <p class="text-white/60 mt-1 text-sm">Agente hecho a mano.</p>
    </div>
    <%= button_to "Eliminar", agents_profile_path(@profile), method: :delete,
          form: { data: { turbo_confirm: "¿Eliminar el perfil «#{@profile.name}»?" } },
          class: "inline-flex items-center px-4 py-2 bg-danger/20 text-danger font-bold tracking-tight rounded-md hover:bg-danger/30 transition-colors text-sm" %>
  </div>

  <%= render "form", profile: @profile, url: agents_profile_path(@profile), method: :patch, submit_label: "Guardar cambios" %>
</div>
