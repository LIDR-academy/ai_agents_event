<%# Renders the latest Estimation::Response — same layout as estimations/show. %>
<% response = estimation.to_response %>
<% result = response.result %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold tracking-tighter text-white">Latest estimation</h2>
    <div class="flex items-center gap-2">
      <span class="text-xs font-bold tracking-tight uppercase bg-brand text-ink-dark px-2 py-1 rounded">
        prompt <%= response.prompt_version %>
      </span>
      <% if response.cached %>
        <span class="text-xs font-bold tracking-tight uppercase bg-success-light text-ink-dark px-2 py-1 rounded">
          cached
        </span>
      <% end %>
    </div>
  </div>

  <% if result.out_of_scope? %>
    <div class="p-5 rounded-md bg-brand/15 border border-brand text-white">
      <p class="font-bold text-brand mb-2">Out of scope</p>
      <p class="text-sm text-white/90"><%= result.summary %></p>
    </div>
  <% else %>
    <p class="text-white/90 leading-relaxed text-sm"><%= result.summary %></p>

    <div class="grid grid-cols-3 gap-3">
      <div class="p-3 rounded-md bg-ink/30 border border-white/10">
        <div class="text-xs uppercase tracking-tight text-white/50 font-bold">Duration</div>
        <div class="text-xl font-bold tracking-tighter text-white mt-1"><%= result.total_duration_weeks %> wk</div>
      </div>
      <div class="p-3 rounded-md bg-ink/30 border border-white/10">
        <div class="text-xs uppercase tracking-tight text-white/50 font-bold">Cost</div>
        <div class="text-xl font-bold tracking-tighter text-white mt-1">
          <%= number_with_delimiter(result.total_cost_eur) %> €
        </div>
      </div>
      <div class="p-3 rounded-md bg-ink/30 border border-white/10">
        <div class="text-xs uppercase tracking-tight text-white/50 font-bold">Confidence</div>
        <div class="text-xl font-bold tracking-tighter text-white mt-1"><%= result.confidence_pct %>%</div>
      </div>
    </div>

    <div class="rounded-md border border-white/10 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-ink/40 text-white/70">
          <tr>
            <th class="text-left p-3 font-bold tracking-tight">Phase</th>
            <th class="text-right p-3 font-bold tracking-tight">Weeks</th>
            <th class="text-right p-3 font-bold tracking-tight">Cost</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          <% result.phases.each do |phase| %>
            <tr>
              <td class="p-3 align-top">
                <div class="font-bold text-white"><%= phase.name %></div>
                <div class="text-white/60 text-xs mt-0.5"><%= phase.summary %></div>
              </td>
              <td class="p-3 text-right align-top text-white/90 tabular-nums"><%= phase.duration_weeks %></td>
              <td class="p-3 text-right align-top text-white/90 tabular-nums">
                <%= number_with_delimiter(phase.cost_eur) %> €
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% acb = estimation.response_payload.is_a?(Hash) ? estimation.response_payload["acb"] : nil %>
  <% if acb.is_a?(Hash) && acb["iterations"].is_a?(Array) %>
    <% if acb["final_decision"] == "synthesize" %>
      <div class="p-4 rounded-md bg-brand-strong/15 border border-brand-strong text-white">
        <p class="font-bold text-brand mb-1">Audit caveats — review did not fully converge</p>
        <p class="text-sm text-white/90">
          The independent reviewer did not approve the estimation in the available iterations. The figures above are the actor's last draft with reduced confidence; see the "Open caveats" section in the summary and the trace below.
        </p>
      </div>
    <% end %>
    <details class="rounded-md border border-white/10 bg-ink/30 p-3">
      <summary class="cursor-pointer text-xs uppercase tracking-tight text-white/70 font-bold">
        Actor-Critic-Boss trace — final: <%= acb["final_decision"] %>,
        <%= acb["iterations_run"] %> iteration(s)
      </summary>
      <ol class="mt-3 space-y-2 text-xs text-white/80">
        <% acb["iterations"].each do |it| %>
          <li class="rounded bg-ink/40 p-2">
            <div class="font-bold text-white">
              Iteration <%= it["iteration"] %> — verdict: <%= it["critic_verdict"] %>
              <span class="text-white/50">(confidence <%= it["critic_confidence"] %>)</span>
            </div>
            <% Array(it["issue_summary"]).each do |issue_line| %>
              <div class="mt-1 text-white/70 font-mono"><%= issue_line %></div>
            <% end %>
            <div class="mt-1 text-white/50">Boss decision: <%= it["decision_after"] %></div>
          </li>
        <% end %>
      </ol>
    </details>
  <% end %>
</div>
